<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <VersionPrefix>0.0.1</VersionPrefix>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <Platforms>AnyCPU</Platforms>
        <Title>Backlot.Start</Title>
        <Authors>Jeroen Wijdeven Holding B.V.</Authors>
        <Copyright>(c) copyright Jeroen Wijdeven Holding B.V. 2026</Copyright>
        <PackageProjectUrl>https://www.backlot.software</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageIcon>bl.png</PackageIcon>
        <!--
          This is the runnable starter app AND the source of the dotnet-new
          template. It is NOT itself a NuGet library: packing is handled by the
          sibling Backlot.Start.Template project, which packs this folder as a
          template package. Keeping it packable here would emit a bogus library
          package and collide with the template's Backlot.Start package id.
        -->
        <IsPackable>false</IsPackable>
        <Configurations>Debug;Release;Development</Configurations>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageReadmeFile>README.MD</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- This includes the file in the actual .nupkg package -->
        <Content Include="README.MD">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Backlot framework project references (local source) -->
        <ProjectReference Include="..\Backlot.Core\Backlot.Core.csproj" />
        <ProjectReference Include="..\Backlot.Defaults\Backlot.Defaults.csproj" />
        <ProjectReference Include="..\Backlot.Authentication.Basic\Backlot.Authentication.Basic.csproj" />
        <ProjectReference Include="..\Backlot.DependencyInjection.Autofac\Backlot.DependencyInjection.Autofac.csproj" />
        <ProjectReference Include="..\Backlot.Http\Backlot.Http.csproj" />
        <ProjectReference Include="..\Backlot.Http.DependencyInjection.Autofac\Backlot.Http.DependencyInjection.Autofac.csproj" />
        <ProjectReference Include="..\Backlot.Services.LiteDB\Backlot.Services.LiteDB.csproj" />
        <ProjectReference Include="..\Backlot.Services.Filesystem.Disk\Backlot.Services.Filesystem.LocalDiskStorage.csproj" />
        <ProjectReference Include="..\Backlot.WebApp\Backlot.WebApp.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Third-party packages (latest stable) -->
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <None Include="local.jsonsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="usersandgroups.json" Condition="Exists('usersandgroups.json')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <VersionSuffix>alpha-$([System.DateTime]::UtcNow.ToString(yyyyMMdd-HHmm))</VersionSuffix>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Development'">
        <VersionSuffix>beta</VersionSuffix>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\bl.png">
            <Pack>True</Pack>
            <PackagePath>
            </PackagePath>
            <Link>bl.png</Link>
        </None>
    </ItemGroup>

</Project>
