<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <VersionPrefix>0.0.1</VersionPrefix>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <Platforms>AnyCPU</Platforms>
        <Title>Backlot.Start</Title>
        <Authors>Jeroen Wijdeven Holding B.V.</Authors>
        <Copyright>(c) copyright Jeroen Wijdeven Holding B.V. 2026</Copyright>
        <PackageProjectUrl>https://www.backlot.software</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <PackageIcon>bl.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <Configurations>Debug;Release;Development</Configurations>
        <IsTemplate>true</IsTemplate>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageReadmeFile>README.MD</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- This includes the file in the actual .nupkg package -->
        <Content Include="README.MD">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Backlot framework packages (Backlot GitHub NuGet feed) -->
        <PackageReference Include="Backlot.Core" Version="0.0.1"  />
        <PackageReference Include="Backlot.Defaults" Version="0.0.1"  />
        <PackageReference Include="Backlot.Authentication.Basic" Version="0.0.1"  />
        <PackageReference Include="Backlot.DependencyInjection.Autofac" Version="0.0.1"  />
        <PackageReference Include="Backlot.Http" Version="0.0.1"  />
        <PackageReference Include="Backlot.Http.DependencyInjection.Autofac" Version="0.0.1"  />
        <PackageReference Include="Backlot.Services.LiteDB" Version="0.0.1"  />
        <PackageReference Include="Backlot.Services.Filesystem.LocalDiskStorage" Version="0.0.1"  />
        <PackageReference Include="Backlot.WebApp" Version="0.0.1"  />
    </ItemGroup>

    <ItemGroup>
        <!-- Third-party packages (latest stable) -->
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <None Include="local.jsonsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="usersandgroups.json" Condition="Exists('usersandgroups.json')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <VersionSuffix>alpha-$([System.DateTime]::UtcNow.ToString(yyyyMMdd-HHmm))</VersionSuffix>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Development'">
        <VersionSuffix>beta</VersionSuffix>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\bl.png">
            <Pack>True</Pack>
            <PackagePath>
            </PackagePath>
            <Link>bl.png</Link>
        </None>
    </ItemGroup>

</Project>
