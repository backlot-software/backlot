<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    This file ships INSIDE the `dotnet new backlot-start` template, so every
    generated project gets it.

    The Backlot framework packages are hosted on Backlot's GitHub Packages feed,
    not on nuget.org. Before your first restore you need a GitHub PAT with the
    read:packages scope. README.MD has the exact command; run it locally or feed
    the PAT in from your CI secret store, and never commit it.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="backlot-github" value="https://nuget.pkg.github.com/backlot-software/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    The GitHub feed answers 401 when unauthenticated, so mapping keeps NuGet from
    probing it for third-party packages and failing the entire restore.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="backlot-github">
      <package pattern="Backlot.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
