{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Backlot Studio (Electron)": {
      "commandName": "Executable",
      "executablePath": "npm",
      "commandLineArgs": "start",
      "workingDirectory": "$(ProjectDir)electron"
    },
    "Backlot Studio (Headless Kestrel)": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "commandLineArgs": "--BacklotStudio:BaseUrl=https://localhost:7221/"
    }
  }
}
