<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AzureFunctionsVersion>v4</AzureFunctionsVersion>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enabled</ImplicitUsings>
		<Configurations>Debug;Release;Development</Configurations>
		<Platforms>AnyCPU</Platforms>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="local.settings.json" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Serilog.Sinks.AzureTableStorage" Version="10.2.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
		<PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
	</ItemGroup>
	<ItemGroup>
		<None Update="host.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="local.settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Never</CopyToPublishDirectory>
		</None>
		<None Update="local.jsonsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="uisettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="usersandgroups.json" Condition="Exists('usersandgroups.json')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="login.mustach.yml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="formula.calculate.test.mustache">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Backlot.Authentication.BuiltIn\Backlot.Authentication.BuiltIn.csproj" />
		<ProjectReference Include="..\Backlot.Core\Backlot.Core.csproj" />
		<ProjectReference Include="..\Backlot.Defaults\Backlot.Defaults.csproj" />
		<ProjectReference Include="..\Backlot.DependencyInjection.Autofac\Backlot.DependencyInjection.Autofac.csproj" />
		<ProjectReference Include="..\Backlot.Http.DependencyInjection.Autofac\Backlot.Http.DependencyInjection.Autofac.csproj" />
		<ProjectReference Include="..\Backlot.Http.Media.Formatters.Csv\Backlot.Http.Media.Formatters.Csv.csproj" />
		<ProjectReference Include="..\Backlot.Http.Media.Formatters.Html\Backlot.Http.Media.Formatters.Html.csproj" />
		<ProjectReference Include="..\Backlot.Functions\Backlot.Functions.csproj" />
		<ProjectReference Include="..\Backlot.Services.Filesystem.Disk\Backlot.Services.Filesystem.LocalDiskStorage.csproj" />
		<ProjectReference Include="..\Backlot.Services.Postmark\Backlot.Services.Postmark.csproj" />
		<ProjectReference Include="..\Backlot.Services.RavenDB\Backlot.Services.RavenDb.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="System.Threading.ExecutionContext" Alias="ExecutionContext" />
	</ItemGroup>
</Project>
