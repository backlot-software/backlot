@page "/scenarios"
@model Backlot.Studio.Areas.Studio.Pages.Scenarios.IndexModel
@{
    ViewData["Title"] = "Scenarios";
}

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 mb-2">Scenarios</h1>
    </div>
    <!-- The machine-readable counterpart of this page: types for a non-.NET client, rather than
         examples for a human. data-turbo="false" so Turbo Drive lets the browser download it. -->
    <div>
        <a asp-area="Studio" asp-page="/Scenarios/Index" asp-page-handler="Spec"
           data-turbo="false" class="btn btn-secondary"
           title="TypeSpec contract for these endpoints">
            <i class="bi bi-download"></i>
            <span>Download .tsp contract</span>
        </a>
    </div>
</div>

<!-- Error message -->
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger mb-6" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@Model.ErrorMessage</span>
        <a asp-area="Studio" asp-page="/Scenarios/Index" class="font-medium ml-2">Retry</a>
    </div>
}

<!-- Search bar. Client-side only: every scenario is already on the page, so filtering here avoids
     re-paying the two API calls a ?q= round-trip would cost, and leaves open <details> examples
     open. Styled to match the Roles search box. -->
@if (Model.Groups.Any())
{
    <div class="card mb-6">
        <div class="card-body">
            @* No method/asp-page: the script cancels the submit. The input is deliberately unnamed so
               that without JS a submit is a plain reload rather than a URL with a dead query string. *@
            <form id="scenario-filter-form" class="flex flex-col md:flex-row items-center gap-3">
                <div class="relative flex-1">
                    <input type="text"
                           id="scenario-filter"
                           class="form-input pe-10"
                           placeholder="Search, f.e. persist user — matches name, endpoint, roles, tags and result"
                           aria-label="Search scenarios"
                           autocomplete="off" />
                    <i class="bi bi-search absolute right-3 top-1/2 -translate-y-1/2 text-secondary-400 pointer-events-none"></i>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn btn-primary" style="min-height:44px">
                        <i class="bi bi-search"></i>
                        <span>Search</span>
                    </button>
                    <button type="button" id="scenario-filter-clear" class="btn btn-ghost hidden" style="min-height:44px">
                        <i class="bi bi-x-lg"></i>
                        <span>Clear</span>
                    </button>
                </div>
            </form>

            <div class="flex items-center justify-between mt-4 pt-4 border-t border-secondary-200">
                <small id="scenario-filter-count" class="text-secondary-500"></small>
            </div>
        </div>
    </div>
}

<!-- Empty state -->
@if (!Model.Groups.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <h3>No scenarios registered</h3>
        <p>The Backlot API returned an empty scenario list. Check that your API is running and has registered scenarios.</p>
        <a href="#" class="btn btn-primary mt-4">
            <i class="bi bi-arrow-clockwise"></i>
            <span>Refresh</span>
        </a>
    </div>
}
else
{
    <!-- Scenarios content -->
    <div class="space-y-6">
        @foreach (var (category, scenarios) in Model.Groups)
        {
            <!-- One element per category so the search can hide a header together with its cards. -->
            <div class="space-y-6" data-scenario-group>
                <!-- Category header -->
                <div class="flex items-center gap-3 mb-4">
                    <h2 class="text-lg font-semibold text-secondary-900">@category</h2>
                </div>

                <!-- Scenarios list -->
                <div class="grid grid-cols-1 gap-4">
                    @foreach (var s in scenarios)
                    {
                        @* The fields the search matches, lowercased server-side. Explicit rather than
                           the card's textContent: the <details> block below carries example JSON that
                           would otherwise produce matches on any common type name. *@
                        var haystack = string.Join(' ',
                            new[] { s.Scenario, s.Result }
                                .Concat(s.Roles)
                                .Concat(s.Tags)
                                .Concat(s.Endpoints)
                                .Where(v => !string.IsNullOrWhiteSpace(v)))
                            .ToLowerInvariant();

                        <div class="card card-hover" data-scenario-card data-search="@haystack">
                            <div class="card-body">
                                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                                    <!-- Scenario info -->
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-2">
                                            <h3 class="text-lg font-semibold text-secondary-900">@s.Scenario</h3>
                                            <span class="badge badge-info">@s.Endpoints.FirstOrDefault()</span>
                                        </div>
                                        
                                        <!-- Description/Result -->
                                        <p class="text-secondary-600 text-sm mb-3">
                                            <strong>Returns:</strong> @s.Result
                                        </p>
                                        
                                      
                                        <p class="text-secondary-600 text-sm mb-3">
                                            <strong>Roles:</strong>
                                            @foreach (var role in s.Roles)
                                            {
                                                <span class="badge badge-primary">@role</span>
                                            }
                                        </p>
                                            
                                        <p class="text-secondary-600 text-sm mb-3">
                                            <strong>Tags:</strong>
                                            @foreach (var tag in s.Tags)
                                            {
                                                <span class="badge badge-secondary">@tag</span>
                                            }
                                        </p>
                                        
                                    </div>

                                    @* Play: hands this scenario's example request body and endpoint to the
                                       Client, the same handover the role Detail Play button makes.
                                       data-turbo-prefetch="false" because the handler has a side effect
                                       (it writes TempData) and Turbo 8 prefetches links on hover by
                                       default, which would fire it before the operator ever clicks. *@
                                    @if (s.Endpoints.Any())
                                    {
                                        <div class="shrink-0 self-start">
                                            <a asp-area="Studio" asp-page="/Scenarios/Index" asp-page-handler="Play"
                                               asp-route-scenario="@s.Scenario"
                                               asp-route-endpoint="@s.Endpoints.First()"
                                               class="btn-icon"
                                               data-turbo-prefetch="false"
                                               title="Play in Client — opens this scenario with its request body"
                                               aria-label="Play @s.Scenario in the Client">
                                                <i class="bi bi-play-fill text-xl text-primary-600"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            
                            <!-- Endpoint info -->
                            @if (s.Endpoints.Any())
                            {
                                Model.Examples.TryGetValue(s.Scenario, out var example);

                                <div class="mt-4 pt-4 border-t border-secondary-200">
                                    <div class="text-sm">
                                        <span class="text-secondary-500">Endpoint:</span>
                                        @if (example != null)
                                        {
                                            <span class="badge badge-secondary ml-2">@example.Method</span>
                                        }
                                        <code class="text-primary-600 ml-2">@s.Endpoints.First()</code>
                                    </div>

                                    @if (example != null)
                                    {
                                        <details class="mt-3">
                                            <summary class="text-sm text-primary-600 cursor-pointer select-none">
                                                Request &amp; response example
                                            </summary>
                                            <div class="mt-3 space-y-3">
                                                @if (!string.IsNullOrWhiteSpace(example.RequestExample))
                                                {
                                                    <div>
                                                        <div class="text-xs text-secondary-500 mb-1">Request body</div>
                                                        <pre class="bg-secondary-50 border border-secondary-200 rounded p-3 overflow-x-auto text-xs"><code>@example.RequestExample</code></pre>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-xs text-secondary-500">
                                                        This endpoint takes no request body.
                                                    </div>
                                                }

                                                <div>
                                                    <div class="text-xs text-secondary-500 mb-1">Response</div>
                                                    <pre class="bg-secondary-50 border border-secondary-200 rounded p-3 overflow-x-auto text-xs"><code>@example.ResponseExample</code></pre>
                                                </div>
                                            </div>
                                        </details>
                                    }
                                </div>
                            }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Shown by the search script when the filter hides every card. -->
    <div id="scenario-no-results" class="empty-state hidden">
        <i class="bi bi-search"></i>
        <h3>No scenarios match your search</h3>
        <p>Try a different search term, or clear the search to see all scenarios.</p>
    </div>
}

<!-- Toast container for notifications -->
<div class="hidden"></div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById('scenario-filter');
            if (!input) return;

            const form      = document.getElementById('scenario-filter-form');
            const clearBtn  = document.getElementById('scenario-filter-clear');
            const countEl   = document.getElementById('scenario-filter-count');
            const noResults = document.getElementById('scenario-no-results');
            const groups    = Array.from(document.querySelectorAll('[data-scenario-group]'));
            const cards     = Array.from(document.querySelectorAll('[data-scenario-card]'));

            // AND over whitespace-separated terms: "persist user" matches a card whose name,
            // endpoint, roles, tags or result contain both.
            function apply() {
                const raw = input.value.trim();
                const terms = raw.toLowerCase().split(/\s+/).filter(Boolean);
                let visible = 0;

                cards.forEach(function (card) {
                    const hay = card.dataset.search || '';
                    const match = terms.every(function (t) { return hay.indexOf(t) !== -1; });
                    card.classList.toggle('hidden', !match);
                    if (match) visible++;
                });

                // A category header is only meaningful while one of its cards is still visible.
                groups.forEach(function (group) {
                    const any = group.querySelector('[data-scenario-card]:not(.hidden)') !== null;
                    group.classList.toggle('hidden', !any);
                });

                if (noResults) noResults.classList.toggle('hidden', visible !== 0);
                if (clearBtn) clearBtn.classList.toggle('hidden', raw === '');
                if (countEl) {
                    countEl.textContent = raw === ''
                        ? 'Showing all ' + cards.length + ' scenarios'
                        : 'Showing ' + visible + ' of ' + cards.length + ' scenarios matching “' + raw + '”';
                }
            }

            input.addEventListener('input', apply);
            if (form) form.addEventListener('submit', function (e) { e.preventDefault(); apply(); });
            if (clearBtn) clearBtn.addEventListener('click', function () {
                input.value = '';
                apply();
                input.focus();
            });

            // Turbo caches the DOM as it stands when you navigate away, so a filtered list would
            // flash back as the restore preview. Reset before the snapshot is taken.
            document.addEventListener('turbo:before-cache', function () {
                input.value = '';
                apply();
            }, { once: true });

            apply();
        })();
    </script>
}
