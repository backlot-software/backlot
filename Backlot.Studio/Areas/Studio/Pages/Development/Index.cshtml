@page "/development"
@model Backlot.Studio.Areas.Studio.Pages.Development.IndexModel
@{
    ViewData["Title"] = "Development";
}

<!-- Header -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-secondary-900 mb-2">Development</h1>
        <p class="text-sm text-secondary-500">Discuss your project with CodeGen. The full conversation is sent to its <code>HandleMessage</code> scenario.</p>
    </div>
</div>

<div id="development-root" class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6">

    <!-- Chat -->
    <div class="card self-start flex flex-col">
        <div id="chat-log" class="card-body flex flex-col gap-4 h-[60vh] overflow-y-auto custom-scrollbar">
            @foreach (var turn in Model.Chat.Turns)
            {
                @if (turn.FromUser)
                {
                    <div class="flex justify-end">
                        <div class="max-w-[80%] rounded-lg rounded-br-none bg-primary-600 text-white px-4 py-2 whitespace-pre-wrap break-words">@turn.Text</div>
                    </div>
                }
                else
                {
                    <div class="flex justify-start">
                        <div class="max-w-[80%] rounded-lg rounded-bl-none bg-secondary-100 text-secondary-900 px-4 py-2 whitespace-pre-wrap break-words">@turn.Text</div>
                    </div>
                }
            }
        </div>

        <!-- Inline failure notice; replaces nothing in the transcript so a failed turn is never stored -->
        <div id="chat-error" class="alert alert-danger mx-6 hidden" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span id="chat-error-text"></span>
        </div>

        <div class="card-footer">
            @* data-turbo="false": the turn is sent with fetch() and the reply patched into the log,
               so Turbo must not try to navigate on submit. *@
            <form id="chat-form" data-turbo="false" class="flex items-end gap-3">
                @Html.AntiForgeryToken()
                <textarea id="chat-message"
                          name="Input.Message"
                          rows="2"
                          class="form-input flex-1 resize-none"
                          placeholder="Enter to send, Shift+Enter for a new line…"
                          autocomplete="off"></textarea>
                <button type="submit" id="chat-send" class="btn btn-primary">
                    <i class="bi bi-send"></i>
                    <span>Send</span>
                </button>
            </form>
        </div>
    </div>

    <!-- CodeGen context, using Studio's existing card components -->
    <div class="flex flex-col gap-6">
        <div class="card self-start">
            <div class="card-header flex items-center justify-between">
                <h2 class="text-sm font-semibold text-secondary-500 uppercase tracking-wider">Conversation</h2>
                <span id="messages-count" class="badge">@Model.Chat.Messages.Count</span>
            </div>
            <div class="card-body text-sm text-secondary-600 space-y-3">
                <p>Your messages are stored in this Studio session and posted as <code>IChat.Messages</code>.</p>
                <p class="text-secondary-500">Messages in this session: <span id="messages-summary" class="font-medium text-secondary-900">@Model.Chat.Messages.Count</span></p>
            </div>
        </div>

        <div class="card self-start">
            <div class="card-header">
                <h2 class="text-sm font-semibold text-secondary-500 uppercase tracking-wider">CodeGen routes</h2>
            </div>
            <div class="card-body text-sm text-secondary-600 space-y-3">
                <p><code>HandleMessage</code> chooses an agent from your latest request:</p>
                <ul class="space-y-2">
                    <li class="flex gap-2"><i class="bi bi-chat-dots text-primary-600"></i><span>Ask a general question for Q&amp;A.</span></li>
                    <li class="flex gap-2"><i class="bi bi-people text-primary-600"></i><span>Include <code>extract roles</code> to use role extraction.</span></li>
                    <li class="flex gap-2"><i class="bi bi-code-square text-primary-600"></i><span>Include <code>generate lowcode</code> to use low-code generation.</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('chat-form');
            if (!form) return;

            const log = document.getElementById('chat-log');
            const input = document.getElementById('chat-message');
            const sendBtn = document.getElementById('chat-send');
            const errorBox = document.getElementById('chat-error');
            const errorText = document.getElementById('chat-error-text');

            const messagesCount = document.getElementById('messages-count');
            const messagesSummary = document.getElementById('messages-summary');

            // --- Transcript -----------------------------------------------------------
            function appendTurn(text, fromUser) {
                const row = document.createElement('div');
                row.className = 'flex ' + (fromUser ? 'justify-end' : 'justify-start');

                const bubble = document.createElement('div');
                bubble.className = 'max-w-[80%] rounded-lg px-4 py-2 whitespace-pre-wrap break-words ' +
                    (fromUser
                        ? 'rounded-br-none bg-primary-600 text-white'
                        : 'rounded-bl-none bg-secondary-100 text-secondary-900');
                bubble.textContent = text;

                row.appendChild(bubble);
                log.appendChild(row);
                log.scrollTop = log.scrollHeight;
                return row;
            }

            function showError(message) {
                errorText.textContent = message;
                errorBox.classList.remove('hidden');
            }

            function clearError() {
                errorBox.classList.add('hidden');
                errorText.textContent = '';
            }

            log.scrollTop = log.scrollHeight;

            // --- Send -----------------------------------------------------------------
            let busy = false;

            async function send() {
                if (busy) return;

                const message = input.value.trim();
                if (!message) {
                    input.focus();
                    return;
                }

                busy = true;
                clearError();

                // The user's turn appears immediately; it is removed again if the call fails, so the
                // transcript on screen always matches the one stored in session.
                const optimistic = appendTurn(message, true);
                input.value = '';

                sendBtn.disabled = true;
                const original = sendBtn.innerHTML;
                sendBtn.innerHTML = '<span class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span><span>Thinking…</span>';

                try {
                    const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
                    const data = new FormData();
                    data.append('Input.Message', message);

                    const res = await fetch('?handler=Send', {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'fetch' },
                        body: data
                    });
                    const payload = await res.json();

                    if (payload.unauthorized) {
                        window.location.href = '@Url.Page("/Login")';
                        return;
                    }

                    if (payload.error) {
                        optimistic.remove();
                        input.value = message;
                        showError(payload.error);
                        return;
                    }

                    appendTurn(payload.message, false);
                    messagesCount.textContent = payload.messageCount;
                    messagesSummary.textContent = payload.messageCount;
                } catch (err) {
                    optimistic.remove();
                    input.value = message;
                    showError('Request failed: ' + String(err));
                } finally {
                    busy = false;
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = original;
                    input.focus();
                }
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                send();
            });

            // Enter sends, Shift+Enter inserts a newline.
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    send();
                }
            });
        })();
    </script>
}
