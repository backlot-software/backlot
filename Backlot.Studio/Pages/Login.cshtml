@page
@model Backlot.Studio.Pages.LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign in — Backlot Studio";
}

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4" style="max-width:400px; width:100%">
        <h4 class="text-center fw-semibold mb-4">Backlot Studio</h4>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">Invalid username or password.</div>
        }

        <form method="post" asp-page="/Login" data-turbo="false">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label">Username</label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>
