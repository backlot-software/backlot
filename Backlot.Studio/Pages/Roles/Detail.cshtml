@page "/roles/{uid}"
@model Backlot.Studio.Pages.Roles.DetailModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["ActiveNav"] = "roles";
    var perms = Model.Permissions;
}

<a href="/roles" class="btn btn-link p-0 mb-3"><i class="bi bi-arrow-left me-1"></i>Back to Roles</a>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
        <a href="/roles" class="alert-link ms-1">Back to Roles</a>
    </div>
}
else
{
    @if (Model.Saved)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            Role saved.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h4 class="fw-semibold mb-3">@Model.PageTitle</h4>

    <div class="d-flex align-items-center gap-2 mb-3">
        <code class="text-muted small">@Model.Uid</code>
        <button data-action="copy-uid" data-uid="@Model.Uid" aria-label="Copy UID to clipboard" class="btn btn-link p-0" style="min-height:44px">
            <i class="bi bi-clipboard"></i>
        </button>
        @if (Model.CanWrite)
        {
            <a href="/roles/@Model.Uid/edit" class="btn btn-primary">Edit Role</a>
        }
        else
        {
            <button class="btn btn-outline-secondary" disabled aria-disabled="true">Edit Role</button>
        }
    </div>

    <h5 class="fw-semibold mt-4 mb-2">Fields</h5>
    <table class="table table-sm table-bordered">
        <colgroup>
            <col style="width: 30%">
            <col style="width: 70%">
        </colgroup>
        <tbody>
            @* __Permission row *@
            <tr>
                <td class="bg-light"><code>__Permission</code></td>
                <td>
                    <span class="badge @(perms.CanCreate ? "bg-success" : "bg-secondary") text-white me-1">CanCreate</span>
                    <span class="badge @(perms.CanRead ? "bg-success" : "bg-secondary") text-white me-1">CanRead</span>
                    <span class="badge @(perms.CanWrite ? "bg-success" : "bg-secondary") text-white me-1">CanWrite</span>
                </td>
            </tr>
            @* __Skills row *@
            <tr>
                <td class="bg-light"><code>__Skills</code></td>
                <td>
                    @if (Model.Skills.Any())
                    {
                        foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-light text-dark border me-1">@skill</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">None</span>
                    }
                </td>
            </tr>
            @* __LastModifiedDate row *@
            <tr>
                <td class="bg-light"><code>__LastModifiedDate</code></td>
                <td>@(Model.LastModifiedDate ?? "—")</td>
            </tr>
            @* Non-system fields *@
            @foreach (var item in Model.Fields)
            {
                <tr>
                    <td class="bg-light"><code>@item.Key</code></td>
                    <td>@item.Value</td>
                </tr>
            }
        </tbody>
    </table>

    <h5 class="fw-semibold mt-4 mb-2">Related Roles</h5>
    <turbo-frame id="related-roles" src="/roles/@Model.Uid/relations" loading="lazy">
        <p class="text-muted small">Loading related roles…</p>
    </turbo-frame>
}
