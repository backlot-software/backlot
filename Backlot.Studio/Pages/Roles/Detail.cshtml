@page "/roles/{uid}"
@model Backlot.Studio.Pages.Roles.DetailModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["ActiveNav"] = "roles";
    var perms = Model.Permissions;
}

<!-- Breadcrumb and back navigation -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
    <div>
        <a href="/roles" class="text-primary-600 hover:text-primary-700 text-sm mb-2 flex items-center gap-1">
            <i class="bi bi-arrow-left"></i>Back to Roles
        </a>
        <h1 class="text-2xl font-bold text-secondary-900">@Model.PageTitle</h1>
    </div>
    <div class="flex gap-3 mt-4 md:mt-0">
        @if (Model.CanWrite)
        {
            <a href="/roles/@Model.Uid/edit" class="btn btn-primary">
                <i class="bi bi-pencil"></i>
                <span>Edit Role</span>
            </a>
        }
        else
        {
            <button class="btn btn-secondary cursor-not-allowed" disabled aria-disabled="true">
                <i class="bi bi-pencil"></i>
                <span>Edit Role</span>
            </button>
        }
    </div>
</div>

<!-- Success message -->
@if (Model.Saved)
{
    <div class="alert alert-success mb-6" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>Role saved successfully.</span>
    </div>
}

<!-- Error message -->
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger mb-6" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@Model.ErrorMessage</span>
        <a href="/roles" class="font-medium ml-2">Back to Roles</a>
    </div>
}
else
{
    <!-- Role header -->
    <div class="card mb-6 animate-fade-in">
        <div class="card-body">
            <div class="flex flex-col md:flex-row items-start gap-6">
                <!-- UID section -->
                <div class="flex-1">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-12 h-12 bg-primary-50 rounded-lg flex items-center justify-center">
                            <i class="bi bi-people text-primary-600 text-xl"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-secondary-900">@Model.PageTitle</h2>
                            <div class="flex items-center gap-2 mt-1">
                                <code class="text-secondary-500 text-sm bg-secondary-100 px-2 py-1 rounded">@Model.Uid</code>
                                <button data-action="copy-uid" data-uid="@Model.Uid" 
                                        aria-label="Copy UID to clipboard" 
                                        class="btn btn-ghost btn-icon text-secondary-500 hover:text-primary-600">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Status badges -->
                    <div class="flex flex-wrap gap-2">
                        <div class="flex items-center gap-2">
                            <span class="text-sm text-secondary-500">Permissions:</span>
                            <span class="@(perms.CanRead ? "badge badge-success" : "badge badge-secondary")">CanRead</span>
                            <span class="@(perms.CanWrite ? "badge badge-success" : "badge badge-secondary")">CanWrite</span>
                        </div>
                    </div>
                </div>
                
                <!-- Metadata -->
                <div class="flex flex-col gap-4 min-w-[200px]">
                    <div>
                        <div class="text-sm text-secondary-500 mb-1">Type</div>
                        <div class="flex flex-wrap gap-1">
                            @if (Model.Skills.Any())
                            {
                                @foreach (var skill in Model.Skills)
                                {
                                    <span class="badge badge-primary">@skill</span>
                                }
                            }
                            else
                            {
                                <span class="text-secondary-400 text-sm">None</span>
                            }
                        </div>
                    </div>
                    <div>
                        <div class="text-sm text-secondary-500 mb-1">Last Modified</div>
                        <div class="font-medium">@(Model.LastModifiedDate ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fields table -->
    <div class="card mb-6 animate-fade-in" style="animation-delay: 100ms">
        <div class="card-header">
            <h3 class="text-lg font-semibold text-secondary-900">Fields</h3>
            <p class="text-sm text-secondary-500 mt-1">Role data and metadata</p>
        </div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="w-full text-sm">
                    <colgroup>
                        <col style="width: 30%">
                        <col style="width: 70%">
                    </colgroup>
                    <tbody>
                        @* __Permission row *@
                        <tr class="border-b border-secondary-100">
                            <td class="bg-secondary-50 p-3">
                                <code class="font-medium text-secondary-700">__Permission</code>
                            </td>
                            <td class="p-3">
                                <span class="@(perms.CanRead ? "badge badge-success" : "badge badge-secondary")">CanRead</span>
                                <span class="@(perms.CanWrite ? "badge badge-success" : "badge badge-secondary") ms-1">CanWrite</span>
                            </td>
                        </tr>
                        @* __Skills row *@
                        <tr class="border-b border-secondary-100">
                            <td class="bg-secondary-50 p-3">
                                <code class="font-medium text-secondary-700">__Skills</code>
                            </td>
                            <td class="p-3">
                                @if (Model.Skills.Any())
                                {
                                    foreach (var skill in Model.Skills)
                                    {
                                        <span class="badge badge-secondary">@skill</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary-400 text-sm">None</span>
                                }
                            </td>
                        </tr>
                        @* LastModifiedDate row *@
                        <tr class="border-b border-secondary-100">
                            <td class="bg-secondary-50 p-3">
                                <code class="font-medium text-secondary-700">LastModifiedDate</code>
                            </td>
                            <td class="p-3">
                                <code class="text-secondary-600">@(Model.LastModifiedDate ?? "—")</code>
                            </td>
                        </tr>
                        @* Non-system fields *@
                        @foreach (var item in Model.Fields)
                        {
                            <tr class="border-b border-secondary-100">
                                <td class="bg-secondary-50 p-3">
                                    <code class="font-medium text-secondary-700">@item.Key</code>
                                </td>
                                <td class="p-3">@item.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Related Roles -->
    <div class="card animate-fade-in" style="animation-delay: 200ms">
        <div class="card-header">
            <h3 class="text-lg font-semibold text-secondary-900">Related Roles</h3>
            <p class="text-sm text-secondary-500 mt-1">Roles connected to this one</p>
        </div>
        <div class="card-body">
            <turbo-frame id="related-roles" src="/roles/@Model.Uid/relations" loading="lazy">
                <div class="text-center p-4">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary-600 mx-auto mb-2"></div>
                    <p class="text-secondary-500 text-sm">Loading related roles…</p>
                </div>
            </turbo-frame>
        </div>
    </div>
}
