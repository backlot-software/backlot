@page "/roles/{uid}/relations"
@model Backlot.Studio.Pages.Roles.RelationsModel
@{ Layout = null; }

<turbo-frame id="related-roles">
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@Model.ErrorMessage</span>
        <a href="/roles/@Model.Uid" class="font-medium ml-2">Retry</a>
    </div>
}
else if (!Model.Relations.Any())
{
    <div class="empty-state py-8">
        <i class="bi bi-people text-secondary-400"></i>
        <h3 class="text-secondary-600">No related roles</h3>
        <p class="text-secondary-500">This role has no related roles.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="w-full text-sm font-sans">
            <thead>
                <tr class="bg-secondary-50">
                    <th class="text-left p-3 border-b font-semibold text-secondary-600">UID</th>
                    <th class="text-left p-3 border-b font-semibold text-secondary-600">Info</th>
                    <th class="text-right p-3 border-b"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rel in Model.Relations)
                {
                    <tr class="hover:bg-secondary-50 border-b border-secondary-100 last:border-b-0">
                        <td class="p-3">
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        class="btn btn-ghost btn-icon"
                                        data-action="copy-uid"
                                        data-uid="@rel.Uid"
                                        aria-label="Copy UID to clipboard">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                                <span class="text-secondary-700 text-sm" title="@rel.Uid">@(rel.Uid.Length > 12 ? rel.Uid[..12] : rel.Uid)</span>
                            </div>
                        </td>
                        <td class="p-3">@rel.Info</td>
                        <td class="p-3 text-right">
                            <a href="/roles/@rel.Uid" 
                               class="btn btn-secondary btn-icon"
                               data-turbo-frame="_top" 
                               data-turbo-action="advance"
                               data-tooltip="View role">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Copy the role UID to the clipboard. Bound once at document level so it
   survives Turbo Frame updates that replace the table without a full navigation. *@
<script>
    if (!window.__copyUidBound) {
        window.__copyUidBound = true;
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-action="copy-uid"]');
            if (!btn) return;

            const uid = btn.dataset.uid;
            if (!uid) return;

            const icon = btn.querySelector('i');

            navigator.clipboard.writeText(uid).then(function () {
                if (icon) {
                    icon.classList.remove('bi-clipboard');
                    icon.classList.add('bi-clipboard-check');
                    setTimeout(function () {
                        icon.classList.remove('bi-clipboard-check');
                        icon.classList.add('bi-clipboard');
                    }, 1500);
                }
            });
        });
    }
</script>
</turbo-frame>
