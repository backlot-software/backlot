@page "/roles/{uid}/edit"
@model Backlot.Studio.Pages.Roles.EditModel
@{
    ViewData["Title"] = "Edit " + Model.PageTitle;
}

<!-- Breadcrumb and back navigation -->
<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">
    <div>
        <a href="/roles/@Model.Uid" class="text-primary-600 hover:text-primary-700 text-sm mb-2 flex items-center gap-1">
            <i class="bi bi-arrow-left"></i>Back to @Model.PageTitle
        </a>
        <h1 class="text-2xl font-bold text-secondary-900">Edit @Model.PageTitle</h1>
    </div>
</div>

<!-- Error message -->
@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger mb-6" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@Model.ErrorMessage</span>
        <a href="/roles/@Model.Uid" class="font-medium ml-2">Back to role</a>
    </div>
}

<!-- UID display -->
<div class="card mb-6 animate-fade-in">
    <div class="card-body">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-warning-50 rounded-lg flex items-center justify-center">
                <i class="bi bi-pencil text-warning-600"></i>
            </div>
            <div>
                <div class="font-medium text-secondary-900">Role UID</div>
                <div class="flex items-center gap-2 mt-1">
                    <code class="text-secondary-500 text-sm bg-secondary-100 px-2 py-1 rounded">@Model.Uid</code>
                    <button data-action="copy-uid" data-uid="@Model.Uid" 
                            aria-label="Copy UID to clipboard" 
                            class="btn btn-ghost btn-icon text-secondary-500 hover:text-primary-600">
                        <i class="bi bi-clipboard"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="mt-3 text-sm text-secondary-500">
            <i class="bi bi-info-circle"></i>
            <span class="ml-1">This identifier cannot be changed.</span>
        </div>
    </div>
</div>

<!-- Validation errors -->
@if (Model.ValidationErrors.Any())
{
    <div class="alert alert-danger mb-6" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span class="mr-2">Please fix the following before saving:</span>
        <ul class="list-disc list-inside mt-2">
            @foreach (var e in Model.ValidationErrors)
            {
                <li class="ml-4">@(e.ErrorMessage ?? "Validation failed.")</li>
            }
        </ul>
    </div>
}

@if (Model.Schema == null && Model.ErrorMessage == null)
{
    <div class="empty-state">
        <i class="bi bi-exclamation-triangle"></i>
        <h3>Nothing to edit</h3>
        <p>No editable schema is visible for this role. This can happen when your account doesn't have access to a scenario that uses this role, so its editable schema isn't returned to you.</p>
    </div>
}
else if (Model.Schema != null && !Model.SchemaFields.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <h3>Nothing to edit</h3>
        <p>This role's schema was found, but it defines no editable fields.</p>
    </div>
}
else if (Model.Schema != null)
{
    <form method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Uid" />

        <!-- Edit form card -->
        <div class="card animate-fade-in">
            <div class="card-header">
                <h3 class="text-lg font-semibold text-secondary-900">Edit Fields</h3>
                <p class="text-sm text-secondary-500 mt-1">Modify the role data below</p>
            </div>
            <div class="card-body">
                <div class="space-y-5">
                    @foreach (var f in Model.SchemaFields)
                    {
                        var val = Model.CurrentValue(f.Field);
                        
                        <!-- Field container -->
                        <div class="@(Backlot.Studio.Pages.Roles.EditModel.IsReadOnly(f) ? "opacity-60" : "")">
                            @if (Backlot.Studio.Pages.Roles.EditModel.IsReadOnly(f))
                            {
                                <label class="form-label">
                                    <code>@f.Field</code>
                                    <span class="text-secondary-400 text-xs ms-2">Read-only</span>
                                </label>
                                <input type="text" 
                                       class="form-input bg-secondary-100 cursor-not-allowed" 
                                       value="@val" 
                                       disabled 
                                       aria-disabled="true" />
                            }
                            else if (Backlot.Studio.Pages.Roles.EditModel.IsBool(f.Type))
                            {
                                <div class="flex items-center gap-3">
                                    <input type="checkbox" 
                                           class="h-5 w-5 text-primary-600 rounded focus:ring-primary-500" 
                                           id="field_@f.Field" 
                                           name="Fields[@f.Field]" 
                                           value="true" 
                                           @(val == "true" ? "checked" : "") />
                                    <label class="form-label cursor-pointer mb-0" for="field_@f.Field"><code>@f.Field</code></label>
                                </div>
                            }
                            else if (Backlot.Studio.Pages.Roles.EditModel.IsNumeric(f.Type))
                            {
                                <label class="form-label" for="field_@f.Field"><code>@f.Field</code></label>
                                <input type="number" 
                                       class="form-input" 
                                       id="field_@f.Field" 
                                       name="Fields[@f.Field]" 
                                       value="@val" />
                            }
                            else
                            {
                                <label class="form-label" for="field_@f.Field"><code>@f.Field</code></label>
                                <input type="text" 
                                       class="form-input" 
                                       id="field_@f.Field" 
                                       name="Fields[@f.Field]" 
                                       value="@val" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Form actions -->
        <div class="flex flex-col md:flex-row gap-3">
            <button type="submit" class="btn btn-primary flex-1">
                <i class="bi bi-check-lg"></i>
                <span>Save changes</span>
            </button>
            <a href="/roles/@Model.Uid" class="btn btn-outline flex-1">
                <i class="bi bi-x-lg"></i>
                <span>Cancel</span>
            </a>
        </div>
    </form>
}
