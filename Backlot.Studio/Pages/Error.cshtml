@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["ActiveNav"] = "";
}

<div class="min-h-[calc(100vh-200px)] flex items-center justify-center">
    <div class="text-center max-w-md">
        <!-- Error icon -->
        <div class="w-20 h-20 bg-danger-50 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="bi bi-exclamation-triangle text-danger-600 text-4xl"></i>
        </div>
        
        <!-- Error title -->
        <h1 class="text-3xl font-bold text-danger-600 mb-2">Error</h1>
        <h2 class="text-xl font-semibold text-secondary-700 mb-6">An error occurred while processing your request.</h2>

        @if (Model.ShowRequestId)
        {
            <div class="bg-secondary-50 border border-secondary-200 rounded-lg p-3 mb-6">
                <div class="text-sm text-secondary-500 mb-1">Request ID</div>
                <code class="text-secondary-700 font-mono">@Model.RequestId</code>
            </div>
        }

        <!-- Development mode info -->
        <div class="card mb-6">
            <div class="card-body">
                <h3 class="text-lg font-semibold text-secondary-900 mb-3">Development Mode</h3>
                <p class="text-secondary-600 mb-4">
                    Swapping to the <strong>Development</strong> environment displays detailed information about the error that occurred.
                </p>
                <p class="text-secondary-600">
                    <strong class="text-danger-600">The Development environment shouldn't be enabled for deployed applications.</strong> 
                    It can result in displaying sensitive information from exceptions to end users.
                </p>
                <div class="mt-4 p-3 bg-secondary-50 rounded-lg">
                    <code class="text-secondary-700">ASPNETCORE_ENVIRONMENT=Development</code>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house"></i>
                <span>Return to Home</span>
            </a>
            <button onclick="history.back()" class="btn btn-outline">
                <i class="bi bi-arrow-left"></i>
                <span>Go Back</span>
            </button>
        </div>
    </div>
</div>
