@page
@model Backlot.Studio.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "dashboard";
}

<!-- Dashboard Header -->
<div class="mb-6">
    <h1 class="text-2xl font-bold text-secondary-900 mb-2">Dashboard</h1>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left column - Health + Quick Actions -->
    <div class="lg:col-span-1 space-y-6">

        <!-- System Status (Healthy) -->
        <div class="stats-card card-hover animate-fade-in" style="animation-delay: 300ms">
            <div class="flex items-center justify-between">
                <div>
                    <div class="stats-card-icon bg-info-50 text-info-600 mb-3">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div class="stats-card-label">Status</div>
                </div>
                @if (Model?.Status?.TimeInMs < 2 && Model?.Status?.Status == 200)
                {
                    <div class="stats-card-value text-success-600">Healthy</div>
                }
            </div>
            <div class="mt-3 flex items-center gap-2">
                @if (Model?.Status?.Status == 200)
                {
                    <span class="status-dot status-online"></span>
                    <span class="text-sm text-secondary-500">@Model.Status.Body</span>
                }
            </div>
        </div>

        <!-- Quick Actions Card -->
        <div class="card animate-fade-in" style="animation-delay: 400ms">
            <div class="card-header">
                <h3 class="text-lg font-semibold text-secondary-900">Quick Actions</h3>
                <p class="text-sm text-secondary-500 mt-1">Get started with common tasks</p>
            </div>
            <div class="card-body">
                <div class="space-y-3">
                    <a href="/scenarios" class="flex items-center gap-3 p-3 rounded-lg bg-secondary-50 hover:bg-secondary-100 transition-colors text-secondary-700 hover:text-primary-600">
                        <div class="w-10 h-10 bg-primary-50 rounded-lg flex items-center justify-center">
                            <i class="bi bi-play-circle text-primary-600"></i>
                        </div>
                        <div>
                            <div class="font-medium">View Scenarios</div>
                            <div class="text-sm text-secondary-500">Manage your API scenarios</div>
                        </div>
                    </a>
                    <a href="/roles" class="flex items-center gap-3 p-3 rounded-lg bg-secondary-50 hover:bg-secondary-100 transition-colors text-secondary-700 hover:text-primary-600">
                        <div class="w-10 h-10 bg-success-50 rounded-lg flex items-center justify-center">
                            <i class="bi bi-people text-success-600"></i>
                        </div>
                        <div>
                            <div class="font-medium">Manage Roles</div>
                            <div class="text-sm text-secondary-500">View and edit role data</div>
                        </div>
                    </a>
                    <a href="#" class="flex items-center gap-3 p-3 rounded-lg bg-secondary-50 hover:bg-secondary-100 transition-colors text-secondary-700 hover:text-primary-600">
                        <div class="w-10 h-10 bg-info-50 rounded-lg flex items-center justify-center">
                            <i class="bi bi-gear text-info-600"></i>
                        </div>
                        <div>
                            <div class="font-medium">Settings</div>
                            <div class="text-sm text-secondary-500">Configure your preferences</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Right column - Log Overview (all other columns) -->
    <div class="lg:col-span-2 space-y-6">
        <div class="card animate-fade-in" style="animation-delay: 700ms">
            <div class="card-header">
                <h3 class="text-lg font-semibold text-secondary-900">Log Overview</h3>
                <p class="text-sm text-secondary-500 mt-1">Latest log entries</p>
            </div>
            <div class="card-body">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                </div>
            </div>
        </div>
    </div>

</div>
