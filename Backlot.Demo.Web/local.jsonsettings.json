{
  "Container": {
    "defaultAssembly": "Backlot.Demo.Web"
  },
  "Backlot": {
    "Services": {
      "AI": {
        "Settings": {
          "ApiKey": "",
          "Endpoint": "https://api.mistral.ai/v1/chat/completions",
          "Model": "mistral-large-latest"
        }
      },
      "LiteDB":{
        "Settings" : {
          "ConnectionString": "mydata.db"
        }
      }
    },
    "Http": {
      "Watching": {
        "DebugWatcher": {
          "WebHookEndpoint": "https://localhost:7221/webhook/debugger",
          "Events": "Ending",
          "Scenarios": "Login"
        }
      }
    }
  }
}