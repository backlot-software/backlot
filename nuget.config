<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Backlot.* packages are published to the private GitHub Packages feed, not to
    nuget.org. Without this file, restoring Backlot.Start (which consumes those
    packages) fails with NU1101 "Unable to find package Backlot.Core".

    Reading from the GitHub feed needs a PAT with the read:packages scope; see
    Backlot.Start/README.MD for the one-time credential command.

    CI does not need credentials: the pipeline builds Backlot.CI.slnf, which
    excludes Backlot.Start, so no Backlot.* package is ever restored there.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="backlot-github" value="https://nuget.pkg.github.com/backlot-software/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping is not just tidiness here: the GitHub feed answers 401 to
    unauthenticated requests, so without a mapping NuGet would probe it for every
    third-party package and fail the whole restore on machines with no PAT.
    Only Backlot.* is ever requested from GitHub Packages.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="backlot-github">
      <package pattern="Backlot.*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
